# Use two or more provider API keys, comma-separated. Never commit real keys.
LLM_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
LLM_MODEL=gemini/gemini-2.0-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-project.vercel.app
ENABLE_FAILURE_SIMULATION=true
# Frontend build variable (set in Vercel):
VITE_API_URL=https://your-backend.onrender.com
